    "@animbrio/interaction-engine": "workspace:*",
    "@animbrio/schema": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.7.0"
  }
